function [feat_matrix,actual_chans,group_ids] = extract_enhanced_features( ...
    folder_path,nfft,window,noverlap,bands,spindle_b,chan_list)

    files_info = dir(fullfile(folder_path,'*.set'));
    file_list = {files_info.name};

    feat_matrix = [];
    group_ids = {};
    actual_chans = {};

    for i = 1:numel(file_list)

        try
            EEG = pop_loadset('filename',file_list{i},'filepath',folder_path);
        catch
            warning('Could not load: %s',file_list{i});
            continue;
        end

        if isempty(EEG.chanlocs) || size(EEG.data,2) < nfft
            continue;
        end

        parts = split(file_list{i},'_');
        current_id = parts{1};
        fs = EEG.srate;

        all_labels = {EEG.chanlocs.labels};
        [~,chan_inds] = intersect(lower(all_labels),lower(chan_list),'stable');

        if isempty(chan_inds)
            continue;
        end

        file_feats = [];

        for c = 1:numel(chan_inds)

            signal = double(EEG.data(chan_inds(c),:));

            [S,F,~] = spectrogram(signal,window,noverlap,nfft,fs);

            if isempty(S)
                continue;
            end

            Pxx = abs(S).^2;

            valid = F >= 0.5 & F <= 50;
            total = sum(Pxx(valid,:),1) + eps;

            rp = @(b) mean(Pxx(F >= b(1) & F <= b(2),:),1) ./ total;

            delta = mean(rp(bands{1}));
            theta = mean(rp(bands{2}));
            alpha = mean(rp(bands{3}));
            beta = mean(rp(bands{4}));
            gamma = mean(rp(bands{5}));

            Pvalid = Pxx(valid,:) ./ total;
            spec_entropy = mean(-sum(Pvalid .* log2(Pvalid + eps),1));

            spec_var = mean(var(Pxx(valid,:),0,1));

            spin_mask = F >= spindle_b(1) & F <= spindle_b(2);
            spin_pxx = Pxx(spin_mask,:);

            spin_pow = mean(mean(spin_pxx,1) ./ total);

            spin_rel = mean(spin_pxx,1) ./ total;
            spin_ent = -spin_rel .* log2(spin_rel + eps);
            spin_ent(isnan(spin_ent)) = 0;

            spin_ent_mean = mean(spin_ent);
            spin_ent_sq = mean(spin_ent.^2);

            spin_var = var(spin_pxx,0,1);
            spindle_de = mean(0.5 * log(2*pi*exp(1) * (spin_var + eps)));

            feats = [delta,theta,alpha,beta,gamma, ...
                     spec_entropy,spec_var,spin_pow, ...
                     spin_ent_mean,spin_ent_sq,spindle_de];

            file_feats = [file_feats,feats];

            actual_chans{end+1} = EEG.chanlocs(chan_inds(c)).labels;

        end

        if ~isempty(file_feats)
            feat_matrix = [feat_matrix;file_feats];
            group_ids = [group_ids;repmat({current_id},size(file_feats,1),1)];
        end

    end
end

function [X_balanced,Y_balanced,G_balanced] = balance_training_data( ...
    X_raw,Y_raw,G_raw,class_a,class_b,numFeatures)

    X_balanced = X_raw;
    Y_balanced = Y_raw;
    G_balanced = G_raw;

    count_a = sum(Y_raw == class_a);
    count_b = sum(Y_raw == class_b);

    if count_a == count_b
        return;
    end

    if count_a < count_b

        minority_class = class_a;
        majority_count = count_b;

    else

        minority_class = class_b;
        majority_count = count_a;

    end

    minority_idx = find(Y_raw == minority_class);
    extra_needed = majority_count - numel(minority_idx);

    sampled_idx = randsample(minority_idx,extra_needed,true);
    jitter = 0.1 * randn(extra_needed,numFeatures);

    X_synth = X_raw(sampled_idx,:) + jitter;
    Y_synth = repmat(categorical(minority_class),extra_needed,1);
    G_synth = G_raw(sampled_idx);

    X_balanced = [X_raw;X_synth];
    Y_balanced = [Y_raw;Y_synth];
    G_balanced = [G_raw;G_synth];

end

function X_norm = normalize_by_subject(X_raw,G)

    X_norm = zeros(size(X_raw));
    subs = unique(G);

    for i = 1:numel(subs)

        idx = ismember(G,subs(i));
        data = X_raw(idx,:);

        mu = mean(data,1);
        sd = std(data,0,1);
        sd(sd == 0) = 1;

        X_norm(idx,:) = (data - mu) ./ sd;

    end
end

function [accuracy,macro_f1,kappa,cm] = classification_metrics(YTrue,YPred)

    class_order = categories(YTrue);
    cm = confusionmat(YTrue,YPred,'Order',categorical(class_order));

    accuracy = trace(cm) / sum(cm(:));

    precision = diag(cm) ./ (sum(cm,1)' + eps);
    recall = diag(cm) ./ (sum(cm,2) + eps);

    f1 = 2 * (precision .* recall) ./ (precision + recall + eps);
    macro_f1 = mean(f1);

    n = sum(cm(:));
    po = trace(cm) / n;
    pe = sum(sum(cm,2) .* sum(cm,1)') / n^2;

    kappa = (po - pe) / (1 - pe + eps);

end
